# Entrypoint and runtime modules
entrypoint = "gateway-server.js"
modules = ["python-3.11", "nodejs-20", "postgresql-16"]

# Primary run command (Run button / default start)
# Source env safely so comments/quotes are handled correctly
run = "sh -c \"set -a && . ./.env.local && set +a && bash scripts/dev-prerun.sh && APP_RUNTIME=workspace node gateway-server.js\""

# Nix/packages configuration
[nix]
packages = ["alsa-lib", "at", "at-spi2-atk", "at-spi2-core", "atk", "cairo", "cups", "dbus", "docker", "fetchutils", "gh", "glib", "google-cloud-sdk-gce", "imagemagick_light", "jq", "libxcb", "libxkbcommon", "lsof", "mailutils", "mesa", "molly-guard", "nano", "nodejs-22", "nspr", "nss", "pango", "pgroll", "python313Packages.conda", "solana-cli", "spidermonkey_91", "tmux", "tree", "unpackerr", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr"]
channel = "stable-25_05"

# Deployment settings (CI-like build/start)
[deployment]
build = ["sh", "-c", "npm ci --omit=dev && npm run build:client"]
run = ["sh", "-c", "node gateway-server.js"]
deploymentTarget = "cloudrun"

# Run button workflow: Project + Run App in parallel.
# - Project task: starts the gateway (port 5000) — webview attaches here.
# - Run App task: starts the standalone agent server on AGENT_PORT (43717,
#   from .env.local) so the remote MCP env connects to a STABLE pinned port
#   instead of whatever Replit assigns. DISABLE_SPAWN_AGENT=1 in .env.local
#   means the gateway does not spawn the agent itself, so we run it here.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "user"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c \"set -a && . ./.env.local && set +a && bash scripts/dev-prerun.sh && APP_RUNTIME=workspace node gateway-server.js\""
waitForPort = 5000

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c \"set -a && . ./.env.local && set +a && node agent-server.js\""
waitForPort = 43717

[workflows.workflow.metadata]
outputType = "webview"

# Verify: the global quality gate (2026-08-11, added at Melody's direction so
# any session — human or Claude — can truly verify work with one click).
# Sequential: stops at the first failure. Mirrors the checks Claude runs
# before claiming "done": eslint 0-warnings → tsc → jest unit suite.
[[workflows.workflow]]
name = "Verify (lint + tsc + tests)"
mode = "sequential"
author = "user"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c \"set -a && . ./.env.local && set +a && npm run lint\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c \"set -a && . ./.env.local && set +a && npx tsc --noEmit\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c \"set -a && . ./.env.local && set +a && npm run test:unit\""

# Test Boot: disposable gateway on port 5199 (already port-mapped above) for
# live endpoint verification — never touches the Run-button server on 5000.
[[workflows.workflow]]
name = "Test Boot (gateway on 5199)"
mode = "sequential"
author = "user"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c \"set -a && . ./.env.local && set +a && APP_RUNTIME=workspace PORT=5199 node gateway-server.js\""
waitForPort = 5199

[agent]
integrations = ["perplexity_v0:1.0.0"]
expertMode = true
# System prompt for Replit IDE Assistant
system_prompt = """
You have full capabilities to help architect and be the code god the end user needs, you slow dow and methodically help build and enterprise level application. You have FULL shell execution capabilities.
RUN bash commands directly - do NOT just suggest them.
You have web_search and web_fetch tools via Anthropic API.
If asked who you are, respond: 'I am Replit Assistant Enhanced with web search, web fetch, and full shell capabilities.'
DO NOT say you cannot run shell commands or search the web - you CAN and SHOULD do both.
"""
model = "claude-opus-4-7"
web_search = true
web_fetch = true
shell_exec = true

[userenv]

[userenv.shared]
PROJECT_ID = "gen-lang-client-0361505751"
# ==========================
# AI Model Configuration
# ==========================
# ALL model defaults live in server/lib/ai/model-registry.js — the single
# source of truth. DO NOT override models here; Replit env vars carry ONLY
# API keys and secrets. (No model names in this comment on purpose: they
# drift — app_rules 'verify-models-live'.)
# ==========================

[userenv.development]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5077
externalPort = 5000

[[ports]]
localPort = 5097
externalPort = 4200

[[ports]]
localPort = 5098
externalPort = 3003

[[ports]]
localPort = 5099
externalPort = 3000

[[ports]]
localPort = 5199
externalPort = 3002

[[ports]]
localPort = 5911
externalPort = 5173

[[ports]]
localPort = 8085
externalPort = 8081
exposeLocalhost = true


