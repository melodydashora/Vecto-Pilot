# .env.local.example — template for the workspace-only .env.local (gitignored).
# Copy to .env.local and fill the secret values. Only keys the code reads are listed
# (2026-09-15 code-reference scan; see docs/architecture/DATABASE_ENVIRONMENTS.md).
# Model names are NOT configured here — they are pinned in server/lib/ai/model-registry.js
# and verified against the live provider lists by scripts/check-model-pins.mjs.
# Replit Secrets hold the same keys for deployment; .env.local overrides them in the workspace.

AGENT_ADMIN_USERS=
AGENT_ALLOWED_IPS=
AGENT_BASE_URL=http://127.0.0.1:43717
AGENT_ENABLED=true
AGENT_HOST=127.0.0.1
AGENT_MAX_TOKENS=
AGENT_PORT=43717
AGENT_PREFIX=/agent
AGENT_SHELL_WHITELIST=*
AGENT_TEMPERATURE=0.2
AGENT_TOKEN=
AGENT_URL=http://127.0.0.1:43717
AI_COACH_TOKEN=
AIRPORT_PROXIMITY_THRESHOLD_MILES=30
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_TIMEOUT_MS=60000
API_PREFIX=/api
API_TIMEOUT_MS=120000
APP_MODE=mono
ASSISTANT_MEMORY_TABLE=agent_memory
BASE_DIR=/home/runner/workspace
BROWSER_GPS_TIMEOUT_MS=8000
CIRCUIT_COOLDOWN_MS=60000
CLAUDE_TIMEOUT_MS=45000
COORD_DELTA_THRESHOLD_KM=0.5
DEFAULT_TIMEOUT_MS=180000
EIDOLON_MEMORY_TABLE=eidolon_memory
EIDOLON_POLICY_PATH=config/eidolon-policy.json
EIDOLON_PORT=3101
EIDOLON_TOKEN=
ENABLE_BACKGROUND_WORKER=true
EXPLORATION_RATE=0.2
GATEWAY_PORT=5000
GEMINI_API_KEY=
GEMINI_LIVE_THINKING_BUDGET=-1
GEMINI_MAX_TOKENS=
GEMINI_TEMPERATURE=1.0
GEMINI_TIMEOUT_MS=60000
GOOGLEAQ_API_KEY=
GOOGLE_MAPS_API_KEY=
GPT5_TIMEOUT_MS=300000
JOB_CLEANUP_INTERVAL_MS=3600000
JWT_SECRET=
LLM_TIMEOUT_MS=180000
LLM_TOTAL_BUDGET_MS=360000
LOG_FORMAT=pretty
LOG_LEVEL=info
LOG_NO_EMOJI=true
LOG_QUIET_COMPONENTS=
LOG_VERBOSE_COMPONENTS=
MAX_REQUESTS_PER_WINDOW=10
MAX_WORKER_RESTARTS=10
MCP_TOKEN=
MIN_BLOCKS_RECOMMENDED=8
OPENAI_API_KEY=
OPENAI_MAX_COMPLETION_TOKENS=
OPENAI_REASONING_EFFORT=high
PLANNER_DEADLINE_MS=300000
PROXIMITY_WEIGHT=2.0
